/* pages/calendar/calendar.wxss */
.month-head { gap: 14rpx; margin-bottom: 18rpx; }
.month-label { font-size: 32rpx; font-weight: 700; min-width: 180rpx; text-align: center; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6rpx; }
.dow { text-align: center; color: var(--dim); font-size: 22rpx; padding: 8rpx 0; }
.cell {
  background: var(--panel2); border: 1rpx solid var(--border);
  border-radius: 12rpx; min-height: 110rpx; padding: 8rpx; overflow: hidden;
}
.cell.empty-cell { background: transparent; border-color: transparent; }
.cell.today { border-color: var(--accent); }
.day-num { font-size: 22rpx; color: var(--muted); margin-bottom: 6rpx; }
.cell.today .day-num { color: var(--accent); font-weight: 700; }
.mini {
  font-size: 19rpx; line-height: 1.3; color: var(--muted);
  padding: 2rpx 6rpx; border-radius: 6rpx; margin-bottom: 4rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  background: rgba(108,158,255,.12);
}
.mini.conf { background: rgba(255,107,107,.18); color: #ffb3b3; }
.mini.work { background: rgba(255,169,77,.14); color: #ffd0a0; }
.tsoon { display: flex; align-items: center; padding: 12rpx 4rpx; border-bottom: 1rpx dashed var(--border); }
.tsoon:last-child { border-bottom: none; }
.legend .leg { font-size: 22rpx; margin-right: 22rpx; }
.leg.conf { color: #ffb3b3; }
.leg.work { color: #ffd0a0; }
.conf-item { color: #ffb3b3; font-size: 25rpx; padding: 8rpx 0; }
