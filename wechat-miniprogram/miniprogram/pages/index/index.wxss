/* pages/index/index.wxss */
.opts { margin-top: 18rpx; gap: 14rpx; }
.opts .picker { flex: 1; }
.search-btn { margin-left: auto; }
.search-head { margin: 4rpx 6rpx 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  background: var(--panel2); border: 1rpx solid var(--border);
  border-radius: 999rpx; padding: 10rpx 26rpx; font-size: 25rpx;
}
.chip.hot { color: var(--accent2, #ffd98a); border-color: rgba(242,178,76,.45); }
