/* 全局样式 —— 深色剧院风 */
page {
  --bg: #12101e;
  --panel: #1b1730;
  --panel2: #221d3d;
  --border: #332c55;
  --text: #ece9f7;
  --muted: #a49fc4;
  --dim: #6f6a92;
  --accent: #f2b24c;
  --pri3: #ff6b6b;
  --pri2: #ffa94d;
  --pri1: #6c9eff;
  --ok: #51cf66;
  --danger: #ff6b6b;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page { padding: 24rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* 卡片 */
.card {
  background: var(--panel);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; display: flex; align-items: center; }
.card-title .hint { font-size: 22rpx; color: var(--dim); font-weight: 400; margin-left: 12rpx; }

/* 文字 */
.muted { color: var(--muted); }
.dim { color: var(--dim); }
.small { font-size: 22rpx; }
.bold { font-weight: 700; }

/* 胶囊标签 */
.pill {
  display: inline-flex; align-items: center;
  font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx;
  border: 1rpx solid var(--border); color: var(--muted); margin-right: 10rpx;
}
.pill.p3 { color: var(--pri3); border-color: rgba(255,107,107,.5); background: rgba(255,107,107,.1); }
.pill.p2 { color: var(--pri2); border-color: rgba(255,169,77,.5); background: rgba(255,169,77,.1); }
.pill.p1 { color: var(--pri1); border-color: rgba(108,158,255,.5); background: rgba(108,158,255,.1); }
.pill.ok { color: var(--ok); border-color: rgba(81,207,102,.5); }
.pill.warn { color: var(--pri2); border-color: rgba(255,212,59,.5); background: rgba(255,212,59,.08); }
.pill.danger { color: var(--danger); border-color: rgba(255,107,107,.5); background: rgba(255,107,107,.08); }

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 14rpx 30rpx; border-radius: 14rpx; font-size: 27rpx;
  background: var(--panel2); color: var(--text);
  border: 1rpx solid var(--border);
}
.btn.primary { background: var(--accent); color: #1a1428; font-weight: 600; border-color: var(--accent); }
.btn.ghost { background: transparent; }
.btn.danger { color: var(--danger); border-color: rgba(255,107,107,.4); }
.btn.sm { padding: 8rpx 20rpx; font-size: 24rpx; border-radius: 10rpx; }
.btn.block { display: flex; width: 100%; }
.btn[disabled] { opacity: .45; }

/* 输入框 */
.input, .picker {
  background: var(--panel2); border: 1rpx solid var(--border);
  border-radius: 14rpx; padding: 16rpx 22rpx; font-size: 28rpx; color: var(--text);
  box-sizing: border-box;
}
.picker { display: flex; align-items: center; justify-content: space-between; }
.picker .arrow { color: var(--dim); }

/* 空状态 */
.empty { text-align: center; padding: 80rpx 30rpx; color: var(--dim); }
.empty .big { font-size: 90rpx; margin-bottom: 20rpx; }
.empty .desc { font-size: 26rpx; color: var(--muted); margin-bottom: 30rpx; }

/* 分割 */
.divider { height: 1rpx; background: var(--border); margin: 20rpx 0; }

/* 倒计时 */
.countdown { font-variant-numeric: tabular-nums; color: var(--accent); font-weight: 700; }
.countdown.hot { color: var(--danger); }

/* 列表项行 */
.row { display: flex; align-items: center; }
.spacer { flex: 1; }

/* 徽标 */
.dot-badge {
  display: inline-block; min-width: 30rpx; height: 30rpx; line-height: 30rpx;
  background: var(--danger); color: #fff; border-radius: 999rpx;
  font-size: 20rpx; text-align: center; padding: 0 8rpx; margin-left: 8rpx;
}

/* 标签页占位通用 */
.tips { font-size: 24rpx; color: var(--muted); line-height: 1.8; }
